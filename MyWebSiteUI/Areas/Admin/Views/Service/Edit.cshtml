@model Service
@{ ViewData["Title"] = "Hizmeti Düzenle"; }
<div class="card-surface rounded-primary p-6 md:p-8"><p class="text-xs font-semibold uppercase tracking-[0.22em] text-brand-dark">İçerik Yönetimi</p><h2 class="mt-2 text-3xl font-bold text-navy-700">Hizmeti Düzenle</h2><form asp-action="Edit" method="post" class="mt-8 space-y-6"><input asp-for="ServiceID" type="hidden" /><div><label asp-for="ServiceTitle" class="mb-2 block text-sm font-medium text-slate-700">Hizmet başlığı</label><input asp-for="ServiceTitle" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 outline-none focus:border-brand-dark focus:ring-2 focus:ring-brand-dark/20" /></div><div><label asp-for="ServiceDescription" class="mb-2 block text-sm font-medium text-slate-700">Açıklama</label><textarea asp-for="ServiceDescription" rows="6" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 outline-none focus:border-brand-dark focus:ring-2 focus:ring-brand-dark/20"></textarea></div><div class="flex gap-3"><button class="rounded-xl bg-brand-dark px-5 py-3 text-sm font-semibold text-white">Güncelle</button><a asp-action="Index" class="rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700">İptal</a></div></form></div>