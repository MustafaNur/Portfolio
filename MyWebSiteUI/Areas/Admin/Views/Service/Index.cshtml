@model List<Service>
@{ ViewData["Title"] = "Hizmetler"; }
<div class="mb-6 flex items-center justify-between"><div><p class="text-xs font-semibold uppercase tracking-[0.22em] text-brand-dark">İçerik Yönetimi</p><h2 class="mt-2 text-3xl font-bold text-navy-700">Hizmetler</h2></div><a asp-action="Create" class="rounded-xl bg-gradient-to-r from-brand-dark to-brand-light px-5 py-3 text-sm font-semibold text-white shadow-glow">+ Hizmet Ekle</a></div><div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">@if (Model?.Any() == true) { foreach (var item in Model) { <article class="card-surface rounded-primary p-6"><div class="mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-violet-100 font-bold text-violet-600">S</div><h3 class="text-lg font-bold text-navy-700">@item.ServiceTitle</h3><p class="mt-2 min-h-16 text-sm leading-6 text-slate-500">@item.ServiceDescription</p><div class="mt-6 flex gap-2"><a asp-action="Edit" asp-route-id="@item.ServiceID" class="rounded-lg bg-amber-400 px-3 py-2 text-xs font-semibold text-white">Düzenle</a><a asp-action="Delete" asp-route-id="@item.ServiceID" onclick="return confirm('Silmek istediğinize emin misiniz?');" class="rounded-lg bg-red-500 px-3 py-2 text-xs font-semibold text-white">Sil</a></div></article> } } else { <div class="card-surface rounded-primary p-10 text-center text-slate-500 md:col-span-2 xl:col-span-3">Kayıt bulunamadı.</div> }</div>