@model List<Contact>
@{ ViewData["Title"] = "İletişim"; }
<div class="mb-6 flex items-center justify-between"><div><p class="text-xs font-semibold uppercase tracking-[0.22em] text-brand-dark">Gelen Kutusu</p><h2 class="mt-2 text-3xl font-bold text-navy-700">İletişim Mesajları</h2></div><a asp-action="Create" class="rounded-xl bg-gradient-to-r from-brand-dark to-brand-light px-5 py-3 text-sm font-semibold text-white shadow-glow">+ Mesaj Ekle</a></div><div class="grid gap-5 lg:grid-cols-2">@if (Model?.Any() == true) { foreach (var item in Model) { <article class="card-surface rounded-primary p-6"><div class="flex items-start justify-between gap-4"><div><h3 class="font-bold text-navy-700">@item.ContactSubject</h3><p class="mt-1 text-sm text-brand-dark">@item.ContactName · @item.ContactEmail</p></div><span class="rounded-full bg-rose-100 px-3 py-1 text-xs font-semibold text-rose-600">Mesaj</span></div><p class="mt-5 text-sm leading-6 text-slate-600">@item.ContactMessage</p><div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-4"><span class="text-xs text-slate-500">@item.ContactPhone</span><span><a asp-action="Edit" asp-route-id="@item.ContactID" class="mr-2 text-xs font-semibold text-amber-500">Düzenle</a><a asp-action="Delete" asp-route-id="@item.ContactID" onclick="return confirm('Silmek istediğinize emin misiniz?');" class="text-xs font-semibold text-red-500">Sil</a></span></div></article> } } else { <div class="card-surface rounded-primary p-10 text-center text-slate-500 lg:col-span-2">Kayıt bulunamadı.</div> }</div>