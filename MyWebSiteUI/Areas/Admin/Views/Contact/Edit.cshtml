@model Contact
@{ ViewData["Title"] = "İletişim Mesajını Düzenle"; }
<div class="card-surface rounded-primary p-6 md:p-8"><p class="text-xs font-semibold uppercase tracking-[0.22em] text-brand-dark">Gelen Kutusu</p><h2 class="mt-2 text-3xl font-bold text-navy-700">İletişim Mesajını Düzenle</h2><form asp-action="Edit" method="post" class="mt-8 space-y-6"><input asp-for="ContactID" type="hidden" /><div class="grid gap-6 md:grid-cols-2"><div><label asp-for="ContactName" class="mb-2 block text-sm font-medium text-slate-700">Ad Soyad</label><input asp-for="ContactName" class="field" /></div><div><label asp-for="ContactEmail" class="mb-2 block text-sm font-medium text-slate-700">E-posta</label><input asp-for="ContactEmail" type="email" class="field" /></div><div><label asp-for="ContactPhone" class="mb-2 block text-sm font-medium text-slate-700">Telefon</label><input asp-for="ContactPhone" class="field" /></div><div><label asp-for="ContactSubject" class="mb-2 block text-sm font-medium text-slate-700">Konu</label><input asp-for="ContactSubject" class="field" /></div></div><div><label asp-for="ContactMessage" class="mb-2 block text-sm font-medium text-slate-700">Mesaj</label><textarea asp-for="ContactMessage" rows="6" class="field"></textarea></div><div class="flex gap-3"><button class="rounded-xl bg-brand-dark px-5 py-3 text-sm font-semibold text-white">Güncelle</button><a asp-action="Index" class="rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700">İptal</a></div></form></div><style>.field{width:100%;border:1px solid #e2e8f0;border-radius:.75rem;background:#fff;padding:.75rem 1rem;outline:none}.field:focus{border-color:#4318ff;box-shadow:0 0 0 3px rgba(67,24,255,.12)}</style>