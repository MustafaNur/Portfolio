@model Biography
@{ ViewData["Title"] = "Biyografiyi Düzenle"; }
<div class="card-surface rounded-primary p-6 md:p-8"><p class="text-xs font-semibold uppercase tracking-[0.22em] text-brand-dark">Profil Yönetimi</p><h2 class="mt-2 text-3xl font-bold text-navy-700">Biyografiyi Düzenle</h2><form asp-action="Edit" method="post" class="mt-8 space-y-6"><input asp-for="BiographyID" type="hidden" /><div><label asp-for="BiographyDetails" class="mb-2 block text-sm font-medium text-slate-700">Biyografi detayları</label><textarea asp-for="BiographyDetails" rows="7" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 outline-none focus:border-brand-dark focus:ring-2 focus:ring-brand-dark/20"></textarea></div><div><label asp-for="BiographyCV" class="mb-2 block text-sm font-medium text-slate-700">CV bağlantısı</label><input asp-for="BiographyCV" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 outline-none focus:border-brand-dark focus:ring-2 focus:ring-brand-dark/20" /></div><div class="flex gap-3"><button class="rounded-xl bg-brand-dark px-5 py-3 text-sm font-semibold text-white">Güncelle</button><a asp-action="Index" class="rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700">İptal</a></div></form></div>