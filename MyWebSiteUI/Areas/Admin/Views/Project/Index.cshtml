@model List<Portfolio>

@{
    ViewData["Title"] = "Projeler";
}

<div class="mb-6 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div>
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-brand-dark">Portfolio Yönetimi</p>
        <h2 class="mt-2 text-3xl font-bold text-navy-700">Projeler</h2>
    </div>
    <a asp-area="Admin" asp-controller="Project" asp-action="Create" class="inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-brand-dark to-brand-light px-5 py-3 text-sm font-semibold text-white shadow-glow transition hover:opacity-95">
        + Yeni Proje Ekle
    </a>
</div>

<div class="card-surface overflow-hidden rounded-primary">
    <div class="overflow-x-auto">
        <table class="min-w-full text-left text-sm text-slate-700">
            <thead class="bg-slate-50 text-xs uppercase tracking-[0.2em] text-slate-500">
                <tr>
                    <th class="px-6 py-4">#</th>
                    <th class="px-6 py-4">Başlık</th>
                    <th class="px-6 py-4">Açıklama</th>
                    <th class="px-6 py-4">Link</th>
                    <th class="px-6 py-4">Durum</th>
                    <th class="px-6 py-4 text-right">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var item = Model[i];
                        <tr class="border-t border-slate-200 align-top">
                            <td class="px-6 py-4 font-semibold text-slate-500">@(i + 1)</td>
                            <td class="px-6 py-4 font-semibold text-navy-700">@item.PortfolioTitle</td>
                            <td class="px-6 py-4 text-slate-600">@item.PortfolioDescription</td>
                            <td class="px-6 py-4">
                                @if (!string.IsNullOrWhiteSpace(item.PortfolioLink))
                                {
                                    <a href="@item.PortfolioLink" target="_blank" class="text-brand-dark underline decoration-2 underline-offset-4">GitHub / Link</a>
                                }
                            </td>
                            <td class="px-6 py-4">
                                @if (item.IsActive)
                                {
                                    <span class="inline-flex rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-700">Aktif</span>
                                }
                                else
                                {
                                    <span class="inline-flex rounded-full bg-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-600">Pasif</span>
                                }
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex justify-end gap-2">
                                    <a asp-area="Admin" asp-controller="Project" asp-action="Edit" asp-route-id="@item.PortfolioID" class="rounded-lg bg-amber-400 px-3 py-2 text-xs font-semibold text-white transition hover:bg-amber-500">Düzenle</a>
                                    <a asp-area="Admin" asp-controller="Project" asp-action="Delete" asp-route-id="@item.PortfolioID" class="rounded-lg bg-red-500 px-3 py-2 text-xs font-semibold text-white transition hover:bg-red-600" onclick="return confirm('Silmek istediğinize emin misiniz?');">Sil</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="px-6 py-10 text-center text-slate-500">Kayıt bulunamadı.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
