<!DOCTYPE html>
<html lang="tr" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        poppins: ['Poppins', 'sans-serif'],
                        dm: ['DM Sans', 'sans-serif']
                    },
                    colors: {
                        navy: {
                            50: '#d0dcfb',
                            100: '#aac0fe',
                            200: '#a3b9f8',
                            300: '#728fea',
                            400: '#3652ba',
                            500: '#1b3bbb',
                            600: '#24388a',
                            700: '#1B254B',
                            800: '#111c44',
                            900: '#0b1437'
                        },
                        brand: {
                            light: '#868CFF',
                            dark: '#4318FF'
                        },
                        lightPrimary: '#F4F7FE',
                        gray: {
                            50: '#f8f9fa',
                            100: '#edf2f7',
                            200: '#e9ecef',
                            300: '#cbd5e0',
                            400: '#a0aec0',
                            500: '#adb5bd',
                            600: '#a3aed0',
                            700: '#707eae',
                            800: '#252f40',
                            900: '#1b2559'
                        }
                    },
                    boxShadow: {
                        soft: '0 20px 27px rgba(0, 0, 0, 0.05)',
                        glow: '0 12px 24px rgba(67, 24, 255, 0.18)'
                    },
                    borderRadius: {
                        primary: '20px'
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'DM Sans', sans-serif; background: #f4f7fe; }
        .dashboard-shell { min-height: 100vh; }
        .dashboard-main { background: radial-gradient(circle at 95% 0%, rgba(134, 140, 255, 0.16), transparent 26rem), #f4f7fe; }
        .card-surface {
            background: rgba(255,255,255,0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(148, 163, 184, 0.18);
            box-shadow: 0 20px 27px rgba(0,0,0,0.05);
        }
    </style>
</head>
<body class="h-full bg-lightPrimary text-slate-800 antialiased">
    <div class="dashboard-shell flex">
        <aside class="hidden w-72 flex-col bg-gradient-to-b from-navy-900 via-navy-800 to-navy-900 p-6 text-white shadow-2xl lg:flex">
            <div class="flex items-center gap-3 border-b border-white/10 pb-6">
                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-brand-light to-brand-dark font-bold text-white shadow-glow">P</div>
                <div>
                    <div class="text-xs uppercase tracking-[0.2em] text-slate-300">Portfolio</div>
                    <div class="text-xl font-bold text-white">Admin</div>
                </div>
            </div>

            <nav class="mt-8 space-y-2">
                <a asp-area="Admin" asp-controller="Project" asp-action="Index" class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-200 transition hover:bg-white/5 hover:text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Project" ? "bg-white/10 text-white" : "")">
                    <span class="inline-block h-2.5 w-2.5 rounded-full bg-brand-light"></span>
                    Projeler
                </a>
                <a asp-area="Admin" asp-controller="Biography" asp-action="Index" class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-200 transition hover:bg-white/5 hover:text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Biography" ? "bg-white/10 text-white" : "")">
                    <span class="inline-block h-2.5 w-2.5 rounded-full bg-cyan-400"></span>
                    Biyografi
                </a>
                <a asp-area="Admin" asp-controller="Service" asp-action="Index" class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-200 transition hover:bg-white/5 hover:text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Service" ? "bg-white/10 text-white" : "")">
                    <span class="inline-block h-2.5 w-2.5 rounded-full bg-violet-400"></span>
                    Hizmetler
                </a>
                <a asp-area="Admin" asp-controller="Skill" asp-action="Index" class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-200 transition hover:bg-white/5 hover:text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Skill" ? "bg-white/10 text-white" : "")">
                    <span class="inline-block h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
                    Yetenekler
                </a>
                <a asp-area="Admin" asp-controller="Education" asp-action="Index" class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-200 transition hover:bg-white/5 hover:text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Education" ? "bg-white/10 text-white" : "")">
                    <span class="inline-block h-2.5 w-2.5 rounded-full bg-amber-400"></span>
                    Eğitim
                </a>
                <a asp-area="Admin" asp-controller="Experience" asp-action="Index" class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-200 transition hover:bg-white/5 hover:text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Experience" ? "bg-white/10 text-white" : "")">
                    <span class="inline-block h-2.5 w-2.5 rounded-full bg-pink-400"></span>
                    Deneyim
                </a>
                <a asp-area="Admin" asp-controller="Certificate" asp-action="Index" class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-200 transition hover:bg-white/5 hover:text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Certificate" ? "bg-white/10 text-white" : "")">
                    <span class="inline-block h-2.5 w-2.5 rounded-full bg-indigo-400"></span>
                    Sertifikalar
                </a>
                <a asp-area="Admin" asp-controller="Contact" asp-action="Index" class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-200 transition hover:bg-white/5 hover:text-white @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Contact" ? "bg-white/10 text-white" : "")">
                    <span class="inline-block h-2.5 w-2.5 rounded-full bg-rose-400"></span>
                    İletişim
                </a>
            </nav>

            <div class="mt-auto rounded-2xl border border-white/10 bg-white/5 p-4">
                <div class="text-xs uppercase tracking-[0.2em] text-slate-300">Durum</div>
                <div class="mt-2 text-lg font-semibold text-white">Online</div>
            </div>
        </aside>

        <div class="flex-1">
            <header class="border-b border-slate-200 bg-white/80 backdrop-blur-sm">
                <div class="flex items-center justify-between px-6 py-4 lg:px-8">
                    <div>
                            <div class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-dark">Portfolio Studio</div>
                            <h1 class="mt-1 text-2xl font-bold text-navy-700">@ViewData["Title"]</h1>
                    </div>
                    <div class="flex items-center gap-3">
                            <div class="hidden text-right sm:block">
                                <div class="text-sm font-semibold text-navy-700">Yönetici</div>
                                <div class="text-xs text-slate-500">İçerik alanı</div>
                            </div>
                            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-brand-light to-brand-dark text-sm font-bold text-white shadow-glow">A</div>
                            <a href="/" class="hidden rounded-xl bg-navy-700 px-4 py-2 text-sm font-medium text-white transition hover:bg-navy-800 sm:inline-flex">Siteye Dön</a>
                    </div>
                </div>
            </header>

            <main class="dashboard-main min-h-[calc(100vh-81px)] p-6 lg:p-8">
                @RenderBody()
            </main>
        </div>
    </div>
</body>
</html>
