@model List<Certificate>
@{ ViewData["Title"] = "Sertifikalar"; }
<div class="mb-6 flex items-center justify-between"><div><p class="text-xs font-semibold uppercase tracking-[0.22em] text-brand-dark">Başarılar</p><h2 class="mt-2 text-3xl font-bold text-navy-700">Sertifikalar</h2></div><a asp-action="Create" class="rounded-xl bg-gradient-to-r from-brand-dark to-brand-light px-5 py-3 text-sm font-semibold text-white shadow-glow">+ Sertifika Ekle</a></div><div class="card-surface overflow-hidden rounded-primary"><div class="overflow-x-auto"><table class="min-w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase tracking-[0.2em] text-slate-500"><tr><th class="px-6 py-4">Sertifika</th><th class="px-6 py-4">Kurum</th><th class="px-6 py-4">Tarih</th><th class="px-6 py-4 text-right">İşlemler</th></tr></thead><tbody>@if (Model?.Any() == true) { foreach (var item in Model) { <tr class="border-t border-slate-200"><td class="px-6 py-4 font-semibold text-navy-700">@item.CertificateTitle</td><td class="px-6 py-4 text-slate-600">@item.CertificateInstitution</td><td class="px-6 py-4 text-slate-500">@item.CertificateDate?.ToString("dd MMM yyyy")</td><td class="px-6 py-4 text-right"><a asp-action="Edit" asp-route-id="@item.CertificateID" class="mr-2 rounded-lg bg-amber-400 px-3 py-2 text-xs font-semibold text-white">Düzenle</a><a asp-action="Delete" asp-route-id="@item.CertificateID" onclick="return confirm('Silmek istediğinize emin misiniz?');" class="rounded-lg bg-red-500 px-3 py-2 text-xs font-semibold text-white">Sil</a></td></tr> } } else { <tr><td colspan="4" class="px-6 py-10 text-center text-slate-500">Kayıt bulunamadı.</td></tr> }</tbody></table></div></div>