@model List<Skill>
@{ ViewData["Title"] = "Yetenekler"; }
<div class="mb-6 flex items-center justify-between"><div><p class="text-xs font-semibold uppercase tracking-[0.22em] text-brand-dark">İçerik Yönetimi</p><h2 class="mt-2 text-3xl font-bold text-navy-700">Yetenekler</h2></div><a asp-action="Create" class="rounded-xl bg-gradient-to-r from-brand-dark to-brand-light px-5 py-3 text-sm font-semibold text-white shadow-glow">+ Yetenek Ekle</a></div><div class="card-surface overflow-hidden rounded-primary"><div class="grid gap-3 p-6 sm:grid-cols-2 lg:grid-cols-3">@if (Model?.Any() == true) { foreach (var item in Model) { <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-white p-4"><span class="font-semibold text-navy-700">@item.SkillName</span><span class="flex gap-2"><a asp-action="Edit" asp-route-id="@item.SkillID" class="text-xs font-semibold text-amber-500">Düzenle</a><a asp-action="Delete" asp-route-id="@item.SkillID" onclick="return confirm('Silmek istediğinize emin misiniz?');" class="text-xs font-semibold text-red-500">Sil</a></span></div> } } else { <p class="p-4 text-slate-500">Kayıt bulunamadı.</p> }</div></div>