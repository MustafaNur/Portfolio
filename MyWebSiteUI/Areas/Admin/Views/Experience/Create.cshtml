@model Experience
@{ ViewData["Title"] = "Deneyim Ekle"; }
<div class="card-surface rounded-primary p-6 md:p-8"><p class="text-xs font-semibold uppercase tracking-[0.22em] text-brand-dark">Kariyer Profili</p><h2 class="mt-2 text-3xl font-bold text-navy-700">Deneyim Ekle</h2><form asp-action="Create" method="post" class="mt-8 space-y-6"><div class="grid gap-6 md:grid-cols-2"><div><label asp-for="ExperienceTitle" class="mb-2 block text-sm font-medium text-slate-700">Pozisyon</label><input asp-for="ExperienceTitle" class="field" /></div><div><label asp-for="ExperienceInstitution" class="mb-2 block text-sm font-medium text-slate-700">Kurum</label><input asp-for="ExperienceInstitution" class="field" /></div><div><label asp-for="ExperienceStartDate" class="mb-2 block text-sm font-medium text-slate-700">Başlangıç</label><input asp-for="ExperienceStartDate" type="date" class="field" /></div><div><label asp-for="ExperienceEndDate" class="mb-2 block text-sm font-medium text-slate-700">Bitiş</label><input asp-for="ExperienceEndDate" type="date" class="field" /></div></div><div><label asp-for="ExperienceDescription" class="mb-2 block text-sm font-medium text-slate-700">Açıklama</label><textarea asp-for="ExperienceDescription" rows="5" class="field"></textarea></div><div class="flex gap-3"><button class="rounded-xl bg-emerald-500 px-5 py-3 text-sm font-semibold text-white">Kaydet</button><a asp-action="Index" class="rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700">İptal</a></div></form></div><style>.field{width:100%;border:1px solid #e2e8f0;border-radius:.75rem;background:#fff;padding:.75rem 1rem;outline:none}.field:focus{border-color:#4318ff;box-shadow:0 0 0 3px rgba(67,24,255,.12)}</style>