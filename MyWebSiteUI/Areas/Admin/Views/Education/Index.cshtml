@model List<Education>
@{ ViewData["Title"] = "Eğitim"; }
<div class="mb-6 flex items-center justify-between"><div><p class="text-xs font-semibold uppercase tracking-[0.22em] text-brand-dark">Kariyer Profili</p><h2 class="mt-2 text-3xl font-bold text-navy-700">Eğitim</h2></div><a asp-action="Create" class="rounded-xl bg-gradient-to-r from-brand-dark to-brand-light px-5 py-3 text-sm font-semibold text-white shadow-glow">+ Eğitim Ekle</a></div><div class="space-y-4">@if (Model?.Any() == true) { foreach (var item in Model) { <article class="card-surface rounded-primary border-l-4 border-amber-400 p-6"><div class="flex flex-col justify-between gap-4 md:flex-row"><div><span class="text-xs font-semibold uppercase tracking-[0.15em] text-amber-500">@item.EducationStartDate?.ToString("yyyy") - @item.EducationEndDate?.ToString("yyyy")</span><h3 class="mt-2 text-lg font-bold text-navy-700">@item.EducationTitle</h3><p class="mt-1 font-medium text-slate-500">@item.EducationInstitution</p><p class="mt-3 text-sm leading-6 text-slate-600">@item.EducationDescription</p></div><div class="flex shrink-0 gap-2"><a asp-action="Edit" asp-route-id="@item.EducationID" class="rounded-lg bg-amber-400 px-3 py-2 text-xs font-semibold text-white">Düzenle</a><a asp-action="Delete" asp-route-id="@item.EducationID" onclick="return confirm('Silmek istediğinize emin misiniz?');" class="rounded-lg bg-red-500 px-3 py-2 text-xs font-semibold text-white">Sil</a></div></div></article> } } else { <div class="card-surface rounded-primary p-10 text-center text-slate-500">Kayıt bulunamadı.</div> }</div>