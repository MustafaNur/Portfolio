@model Education
@{ ViewData["Title"] = "Eğitim Ekle"; }
<div class="card-surface rounded-primary p-6 md:p-8"><p class="text-xs font-semibold uppercase tracking-[0.22em] text-brand-dark">Kariyer Profili</p><h2 class="mt-2 text-3xl font-bold text-navy-700">Eğitim Ekle</h2><form asp-action="Create" method="post" class="mt-8 space-y-6"><div class="grid gap-6 md:grid-cols-2"><div><label asp-for="EducationTitle" class="mb-2 block text-sm font-medium text-slate-700">Bölüm / Başlık</label><input asp-for="EducationTitle" class="field" /></div><div><label asp-for="EducationInstitution" class="mb-2 block text-sm font-medium text-slate-700">Kurum</label><input asp-for="EducationInstitution" class="field" /></div><div><label asp-for="EducationStartDate" class="mb-2 block text-sm font-medium text-slate-700">Başlangıç</label><input asp-for="EducationStartDate" type="date" class="field" /></div><div><label asp-for="EducationEndDate" class="mb-2 block text-sm font-medium text-slate-700">Bitiş</label><input asp-for="EducationEndDate" type="date" class="field" /></div></div><div><label asp-for="EducationDescription" class="mb-2 block text-sm font-medium text-slate-700">Açıklama</label><textarea asp-for="EducationDescription" rows="5" class="field"></textarea></div><div class="flex gap-3"><button class="rounded-xl bg-emerald-500 px-5 py-3 text-sm font-semibold text-white">Kaydet</button><a asp-action="Index" class="rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700">İptal</a></div></form></div><style>.field{width:100%;border:1px solid #e2e8f0;border-radius:.75rem;background:#fff;padding:.75rem 1rem;outline:none}.field:focus{border-color:#4318ff;box-shadow:0 0 0 3px rgba(67,24,255,.12)}</style>