<!DOCTYPE html>
<!--[if lt IE 7 ]><html class="ie ie6" lang="en"> <![endif]-->
<!--[if IE 7 ]><html class="ie ie7" lang="en"> <![endif]-->
<!--[if IE 8 ]><html class="ie ie8" lang="en"> <![endif]-->
<!--[if (gte IE 9)|!(IE)]><!--><html lang="en"> <!--<![endif]-->

<partial name="_HeadPartial" />

<body>


<!-- Wrapper All -->
<div class="rewall_fn_wrapper_all" data-nav-skin="transdark">
	
	<!-- Wrapper -->
	<div class="rewall_fn_wrapper">
	
		<partial name="_MenuPartial" />
	
	
		<!-- Color Scheme -->
		<partial name="_ColorSchemePartial" />
		<!-- /Color Scheme -->
		
		
		<!-- Left Sidebar -->
		<!-- You can set up minimum and maximum width for sidebar (in px). Minimum width is 350 -->
		<partial name="_NavBarPartial" />
		<!-- /Left Sidebar -->
		
		
		
			
		<!-- Main Content -->
		<div class="rewall_fn_content">
			<div class="fn__page">
				
				@RenderBody();
				<!-- About Section -->
				<section class="about" id="about">
					
					<!-- About Modern Shortcode -->
					<div class="fn_cs_about_modern">
						<div class="container">
							<div class="row">
								
								<div class="left_part">
									<div class="left_in" id="scene">
										<div class="layer border" data-depth="0.2">
											<span class="span1"></span>
											<span class="span2"></span>
											<img src="~/mainpack/html/img/thumb/450-550.jpg" alt="">
										</div>
										<div class="img_holder layer" data-depth="0.3">
											<img src="~/mainpack/html/img/thumb/450-550.jpg" alt="">
											<div class="abs_img" data-bg-img="~/mainpack/html/img/about.jpg"></div>
										</div>
										<div class="dots layer" data-switch="disable" data-depth="0.4">
										</div>
									</div>
								</div>
								
								<div class="right_part">
									
									<!-- Main Title -->
									<div class="main_title">
										<h3>Developer</h3>
										<p>I am a C# and ASP.NET Core developer based in Istanbul. I focus on backend and web development. I enjoy developing modern web applications and continuously improving my skills.</p>
										<img src="img/signature.png" alt="" />
									</div>
									<!-- /Main Title -->
									
								</div>
								
							</div>
						</div>
					</div>
					<!-- About Modern Shortcode -->
					
				</section>
				<!-- /About Section -->
				
				
				<!-- Scroll to next section -->
				<div class="fn__next_section">
					<div class="container"><span></span></div>
					<a href="#">
						<img src="svg/right-arrow.svg" alt="" class="fn__svg" />
						<span class="fn__tooltip">Double click to scroll the screen to previous section</span>
					</a>
				</div>
				<!-- /Scroll to next section -->
				
				<!-- Biography Section -->
				@await Component.InvokeAsync("BiographyList")
				<!-- /Biography Section -->

				<!-- Tabs Shortcode -->
					<div class="fn_cs_tabs">
						<div class="container max880">
							<div class="row">
								
								<!-- Tab: Header -->
								<div class="tab_header">
									<ul>
										<li class="active"><a href="#tab1">Experience</a></li>
										<li><a href="#tab2">Education</a></li>
										<li><a href="#tab3">Skills</a></li>
									</ul>
								</div>
								<!-- /Tab: Header -->
								
								<!-- Tab: Content -->
								<div class="tab_content">
									
									<!-- #1 tab content Experience -->
									@await Component.InvokeAsync("Experience")
									<!-- /#1 tab content -->
									
									<!-- #2 tab content -->
									<div id="tab2" class="tab_item">
										
										<!-- Boxed List -->
										<div class="fn_cs_boxed_list">
											<ul>
												<li>
													<div class="item">
														<div class="item_top">
															<h5>Frenify University</h5>
															<span>( 2014 — 2017 )</span>
														</div>
														<h3>Computer Science</h3>
														<p>Adipisicing Lorem ipsum dolor sit amet, consectetur elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. </p>
													</div>
												</li>
												<li>
													<div class="item">
														<div class="item_top">
															<h5>Edu University</h5>
															<span>( 2011 — 2014 )</span>
														</div>
														<h3>Master Degree</h3>
														<p>Adipisicing Lorem ipsum dolor sit amet, consectetur elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. </p>
													</div>
												</li>
												<li>
													<div class="item">
														<div class="item_top">
															<h5>Clolumbia College</h5>
															<span>( 2007 — 2011 )</span>
														</div>
														<h3>Bachelor Degree</h3>
														<p>Adipisicing Lorem ipsum dolor sit amet, consectetur elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. </p>
													</div>
												</li>
											</ul>
										</div>
										<!-- /Boxed List -->
											
									</div>
									<!-- /#2 tab content -->
									
									<!-- #3 tab content -->
									<div id="tab3" class="tab_item">
										
										<!-- Progress Bar -->
										<div class="fn_cs_progress_bar">
											
											<div class="progress_item" data-value="92">
												<div class="item_in">
													<h3 class="progress_title">Adobe Photoshop</h3>
													<span class="progress_percent"></span>
													<div class="progress_bg"></div>
												</div>
											</div>
											
											<div class="progress_item" data-value="95">
												<div class="item_in">
													<h3 class="progress_title">HTML5 &amp; CSS3</h3>
													<span class="progress_percent"></span>
													<div class="progress_bg"></div>
												</div>
											</div>
											
											<div class="progress_item" data-value="80">
												<div class="item_in">
													<h3 class="progress_title">WordPress</h3>
													<span class="progress_percent"></span>
													<div class="progress_bg"></div>
												</div>
											</div>
											
											<div class="progress_item" data-value="85">
												<div class="item_in">
													<h3 class="progress_title">Adobe Illustrator</h3>
													<span class="progress_percent"></span>
													<div class="progress_bg"></div>
												</div>
											</div>
											
										</div>
										<!-- /Progress Bar -->
										
										<!-- Description -->
										<div class="fn_cs_desc">
											<p>A freelance creative designer with a love for minimal design, clean typography and well-written code, located in San Francisco. Provide high quality and cost effective offshore web and software development services. Wide range of web and software development services across the world.</p>
										</div>
											
									</div>
									<!-- /#2 tab content -->
									
								</div>
								<!-- /Tab: Content -->
								
							</div>
						</div>
					</div>
					<!-- /Tabs Shortcode -->

				<!-- Scroll to next section -->
				<div class="fn__next_section">
					<div class="container"><span></span></div>
					<a href="#">
						<img src="svg/right-arrow.svg" alt="" class="fn__svg" />
						<span class="fn__tooltip">Double click to scroll the screen to previous section</span>
					</a>
				</div>
				<!-- /Scroll to next section -->
				
				<!-- Portfolio Section -->
				@await Component.InvokeAsync("PortfolioList")
				<!-- /Portfolio Section -->
				
				
				<!-- Scroll to next section -->
				<div class="fn__next_section">
					<div class="container"><span></span></div>
					<a href="#">
						<img src="svg/right-arrow.svg" alt="" class="fn__svg" />
						<span class="fn__tooltip">Double click to scroll the screen to previous section</span>
					</a>
				</div>
				<!-- /Scroll to next section -->
				
				<!-- Service Section -->
				@await Component.InvokeAsync("ServiceList")
				<!-- /Service Section -->
				
				
				
				<!-- Scroll to next section -->
				<div class="fn__next_section">
					<div class="container"><span></span></div>
					<a href="#">
						<img src="svg/right-arrow.svg" alt="" class="fn__svg" />
						<span class="fn__tooltip">Double click to scroll the screen to previous section</span>
					</a>
				</div>
				<!-- /Scroll to next section -->
				
				
				
				
				<!-- Contact Section -->
				@await Component.InvokeAsync("ContactList")
				<!-- /Contact Section -->
				
		
			</div>
		</div>
		<!-- Main Content -->
		
	</div>
	<!-- /Wrapper -->
	
</div>
<!-- /Wrapper All -->



<!-- Scripts -->
<partial name="_ScriptPartial" />
<!-- /Scripts -->

</body>
</html>
