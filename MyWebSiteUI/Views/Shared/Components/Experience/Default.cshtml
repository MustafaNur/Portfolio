
@model List<Experience>
@{
    ViewData["Title"] = "Default";
}


<div id="tab1" class="tab_item active">
										
										<!-- Boxed List -->
										<div class="fn_cs_boxed_list">
											<ul>
												@foreach (var item in Model)
												{
													<li>
														<div class="item">
															<div class="item_top">
																<h5>@item.ExperienceInstitution</h5>
																<span>( @item.ExperienceStartDate?.ToString("yyyy") — @item.ExperienceEndDate?.ToString("yyyy") )</span>
															</div>
															<h3>@item.ExperienceTitle</h3>
															<p>@item.ExperienceDescription</p>
														</div>
													</li>
												}
												
											</ul>
										</div>
										<!-- /Boxed List -->
										
									</div>