
@model List<Portfolio>
@{
    ViewData["Title"] = "Default";
}



<div>
    <section class="portfolio" id="portfolio">
				
					<!-- Main Title -->
					<div class="main_title center">
						<div class="container max880">
							<h3>Portfolio</h3>
							<p>I’m working on building modern, scalable, and AI-powered applications using ASP.NET Core and artificial intelligence technologies. My goal is to combine robust backend architectures with intelligent AI solutions to create fast, secure, responsive, and user-focused digital products.

From developing web applications and APIs with ASP.NET Core to integrating AI-powered features, automation, and data-driven solutions, I’m continuously improving my skills and building real-world projects.
							</p>
							<div class="main_button">
								<a href="https://github.com/MustafaNur" target="_blank">Visit my portfolio on GitHub.</a>
							</div>
						</div>
					</div>
					<!-- /Main Title -->
					
					<div class="portfolio_list">
						<div class="container">
							<ul class="fn__masonry gallery_zoom">

								@foreach (var item in Model)
								{
								<li class="masonry_in">
									<div class="item">
										<div class="title_holder">
											<h3><a class="fn__link zoom" href="@item.PortfolioImage" data-title="Smashing Magazine Print">@item.PortfolioTitle</a></h3>
											<p>@item.PortfolioDescription</p>
										</div>

										<div class="img_holder">
											<a class="zoom" href="@item.PortfolioImage" data-title="Smashing Magazine Print"></a>
											<img src="@item.PortfolioImage" alt="Project Image" style="width: 100%; height: 450px;" />
											<div class="abs_img" data-bg-img="@item.PortfolioImage"></div>
										</div>
									</div>
								</li>
								}
							</ul>
						</div>
					</div>
					
					
				</section>
</div>
