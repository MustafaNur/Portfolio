
@model List<Biography>
@{
    ViewData["Title"] = "Default";
}


<div>
    <section class="biography" id="biography">
					@foreach (var item in Model)
					{
						<div class="main_title center">
						<div class="container max880">
							<h3>Biography</h3>
							<p>@item.BiographyDetails</p>
							
						</div>
					</div>
					<!-- /Main Title -->
					}
					<!-- Main Title -->
					
					
					
					<!-- Info Items -->
					<div class="fn_cs_info_items">
						<div class="container">
							<div class="row">
								
								<ul>
									<li class="wow fadeInUp" data-wow-delay="0s"><p>Name: <span>Mustafa Nur</span></p></li>
									<li class="wow fadeInUp" data-wow-delay="0.45s"><p>Adress: <span>Turkey | Kocaeli</span></p></li>
									@* <li class="wow fadeInUp" data-wow-delay="0.6s"><p>Phone: <span><a href="tel:+17785355344">(+1) 7785 355 344</a></span></p></li> *@
									<li class="wow fadeInUp" data-wow-delay="0.75s"><p>LinkedIn: <span><a href="https://www.linkedin.com/in/mustafa-nur-875768220/">Linkedin Profile</a></></span></p></li>
									<li class="wow fadeInUp" data-wow-delay="0.9s"><p>Email: <span><a href="mailto:mustafanur8241@gmail.com">mustafanur8241@gmail.com</a></span></p></li>
								</ul>
								
							</div>
						</div>
					</div>
					<!-- /Info Items -->
					
					
					<!-- Download CV Button -->
					<div class="fn_cs_cv_btn">
						<div class="container">
							<span class="line top_hover"></span>
							<span class="line bottom_hover"></span>
							<span class="line top"></span>
							<span class="line bottom"></span>
							<a href="~/mainpack/html/img/cv.pdf" download>
								<span class="icon">
									<img src="~/mainpack/html/svg/inbox.svg" alt="" class="fn__svg" />
									<img src="~/mainpack/html/svg/arrow.svg" alt="" class="fn__svg arrow" />
								</span>
								<span>Download CV</span>
							</a>
						</div>
					</div>
					<!-- /Download CV Button -->
					
					
					
					
				</section>
</div>