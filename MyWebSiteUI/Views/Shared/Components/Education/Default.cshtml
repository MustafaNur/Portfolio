@using Microsoft.AspNetCore.Http.Features

@model List<Education>
@{
    ViewData["Title"] = "Default";
}

<div id="tab3" class="tab_item">
										
										<!-- Boxed List -->
										<div class="fn_cs_boxed_list">
											<ul>
												
                                                    @foreach (var item in Model)
                                                    {
														<li>
													<div class="item">
														<div class="item_top">
															<h5>@item.EducationInstitution</h5>
															<span>( @item.EducationStartDate?.ToString("yyyy") - @item.EducationEndDate?.ToString("yyyy") )</span>
														</div>
														<h3>@item.EducationTitle</h3>
														<p>@item.EducationDescription</p>
													</div>
													</li>
                                                    }
													
												</li>
												
											</ul>
										</div>
										<!-- /Boxed List -->
											
									</div>
