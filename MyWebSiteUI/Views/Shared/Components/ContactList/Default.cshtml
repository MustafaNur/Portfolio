
@model List<Contact>
@{
    ViewData["Title"] = "Default";
}


<div>
    <section class="contact" id="contact">
					
					<!-- Main Title -->
					<div class="main_title center">
						<div class="container max880">
							<h3>Contact</h3>
						</div>
					</div>
					<!-- /Main Title -->
					
					<!-- Contact -->
					<div class="rewall_fn_contact">
						<div class="container max880">					
							
							<!-- Contact Form -->
							<form class="contact_form" action="/Home/SubmitContact" method="post" autocomplete="off" data-email="frenifyteam@gmail.com">
								
								<!--
								 	Don't remove below code in avoid to work contact form properly.
									You can chance dat-success value with your one. It will be used when user will try to contact via contact form and will get success message.
								-->
								<div class="success" data-success="Your message has been received, we will contact you soon."></div>
								<div class="empty_notice"><span>Please Fill Required Fields!</span></div>
								<!-- -->
								
								<div class="items_wrap">
									<div class="items">
										<input type="hidden" name="ContactSubject" value="Website Contact" />
										<div class="item half">
											<div class="input_wrapper">
												<input id="name" name="ContactName" type="text" />
												<span class="moving_placeholder">Name *</span>
											</div>
										</div>
										<div class="item half">
											<div class="input_wrapper">
												<input id="email" name="ContactEmail" type="email" />
												<span class="moving_placeholder">Email *</span>
											</div>
										</div>
										<div class="item">
											<div class="input_wrapper">
												<input id="phone" name="ContactPhone" type="tel" />
												<span class="moving_placeholder">Phone</span>
											</div>
										</div>
										<div class="item">
											<div class="input_wrapper">
												<textarea id="message" name="ContactMessage"></textarea>
												<span class="moving_placeholder">Message</span>
											</div>
										</div>
										<div class="item">
											<a id="send_message" href="#">Send Message</a>
										</div>
									</div>
								</div>
							</form>
							<!-- /Contact Form -->
							
							
							<!-- Contact Info -->
							<div class="fn_cs_contact_info">
								<p>Address</p>
								<h3> Istanbul - Turkey </h3>
								<p><a class="fn__link" href="mailto:mustafanur8241@gmail.com">mustafanur8241@gmail.com</a></p>
							</div>
							<!-- /Contact Info -->
							
							
						</div>
					</div>
					<!-- /Contact -->
					
				</section>
</div>
